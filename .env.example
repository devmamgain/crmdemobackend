# --- Database ---
MONGO_URI=mongodb://127.0.0.1:27017/marketflow

# --- Server ---
PORT=5000
CLIENT_URL=http://localhost:5173

# --- LLM (optional, any OpenAI-compatible provider). Leave LLM_API_KEY empty to use deterministic fallback analysis.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# --- FMV business rule: recommended acquisition price = FMV * FMV_BUY_RATIO
FMV_BUY_RATIO=0.80
# Expected resale realization as a share of FMV (estimated resale value = FMV * FMV_RESALE_RATIO)
FMV_RESALE_RATIO=0.95
